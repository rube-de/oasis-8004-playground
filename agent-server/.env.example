# PRODUCTION CONFIGURATION (ROFL MODE - DEFAULT)
# Keys are generated securely in TEE via ROFL
#
# Copy this file to .env and configure for your deployment:
#   cp .env.example .env
#
# Usage:
#   docker-compose up --build

# ============================================================================
# DEPLOYMENT MODE
# ============================================================================

# ROFL mode is the DEFAULT (USE_LOCAL_MODE is false or unset)
# Keys are generated securely in Trusted Execution Environment (TEE)
# No PRIVATE_KEY needed - keys never leave the TEE

# Uncomment ONLY for local development (requires PRIVATE_KEY):
# USE_LOCAL_MODE=true

# ============================================================================
# NETWORK CONFIGURATION (Required)
# ============================================================================

# Ethereum RPC endpoint URL
# ERC-8004 registries are deployed on Ethereum Sepolia and L2s
# Default: Ethereum Sepolia testnet
RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# Deployed IdentityRegistry contract address (v1.0 - ERC-721 based)
# Ethereum Sepolia deployment (deterministic address):
IDENTITY_REGISTRY_ADDRESS=0x7177a6867296406881E20d6647232314736Dd09A

# ============================================================================
# AGENT DOMAIN (Required)
# ============================================================================

# Domain for RFC 8615 AgentCard hosting
# v1.0 automatically registers with tokenURI: http://{AGENT_DOMAIN}/.well-known/agent-card.json
# This enables tokenURI-based discovery (agentId → tokenURI → AgentCard)
#
# Examples:
# - Production: Use your public domain (e.g., "agent.example.com")
# - Docker internal: Use service name (e.g., "agent-server:80")
AGENT_DOMAIN=agent.example.com

# ============================================================================
# ⚠️ SECURITY WARNING
# ============================================================================

# DO NOT SET PRIVATE_KEY IN PRODUCTION!
# ROFL mode generates keys securely in TEE.
# If PRIVATE_KEY is present, it will be IGNORED in ROFL mode.

# For local development with private keys, use:
#   docker-compose -f docker-compose.local.yml up
#   And configure .env.local with USE_LOCAL_MODE=true

# ============================================================================
# ROFL CONFIGURATION (Required in ROFL mode)
# ============================================================================

# Key ID for ROFL key generation (must be stable across restarts)
# Example: agent-server-key, my-server-001, etc.
ROFL_KEY_ID=agent-server-key

# ============================================================================
# AGENT METADATA CONFIGURATION
# ============================================================================

# Agent metadata (name, description, skills, capabilities) is now configured
# in agent_config.json. This separates static agent configuration from runtime
# environment variables.
#
# Edit agent_config.json to customize:
#   - Agent name and description
#   - Skills and capabilities
#   - Trust models
#   - Protocol versions
#   - Infrastructure metadata
#
# Location: ./agent_config.json

# ============================================================================
# API SERVER CONFIGURATION (Optional)
# ============================================================================

# Port for AgentCard API server
# Default: 80 for Docker (mapped to 8001 on host)
API_PORT=80

# ============================================================================
# OPERATIONAL SETTINGS (Optional)
# ============================================================================

# Logging verbosity (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Gas estimation safety multiplier (default: 1.2)
GAS_MULTIPLIER=1.2

# Transaction confirmation timeout in seconds (default: 120)
TX_TIMEOUT=120

# ============================================================================
# OPTIONAL REGISTRY ADDRESSES (v1.0)
# ============================================================================

# Reputation Registry for cryptographic feedback system
# Ethereum Sepolia deployment (deterministic address):
REPUTATION_REGISTRY_ADDRESS=0xB5048e3ef1DA4E04deB6f7d0423D06F63869e322

# Validation Registry for independent work verification
# Ethereum Sepolia deployment (deterministic address):
VALIDATION_REGISTRY_ADDRESS=0x662b40A526cb4017d947e71eAF6753BF3eeE66d8

# ============================================================================
# DEPLOYMENT NOTES
# ============================================================================

# ERC-8004 Registry Networks:
# The registries are deployed at deterministic addresses on multiple networks:
# - Ethereum Sepolia (11155111)
# - Base Sepolia (84532)
# - Optimism Sepolia (11155420)
# - Mode Testnet (919)
# - 0G Testnet (16602)
#
# Update RPC_URL to connect to your preferred network.
# Registry addresses remain the same across all networks.

# ROFL Setup (for key generation):
# 1. Ensure ROFL service (rofl-appd) is running before starting the agent
# 2. The ROFL socket must be accessible at /run/rofl-appd.sock (default)
# 3. Docker Compose will automatically mount the ROFL socket
# 4. Keys are persistent - same ROFL_KEY_ID will always get the same keys
# 5. For key rotation, change ROFL_KEY_ID (will generate new keys)

# Verify ROFL service status:
#   systemctl status rofl-appd

# Check ROFL socket:
#   ls -la /run/rofl-appd.sock

# Note: ROFL (running on host) provides key generation via TEE,
# while agents connect to Ethereum networks for registry operations.
