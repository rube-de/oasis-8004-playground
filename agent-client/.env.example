# Required Configuration
# Ethereum RPC endpoint URL (default: local hardhat node)
RPC_URL=http://localhost:8545

# Private key for transaction signing (without 0x prefix)
# WARNING: Never commit actual private keys to version control
PRIVATE_KEY=your_private_key_here

# Deployed IdentityRegistry contract address (v1.0 - ERC-721 based)
IDENTITY_REGISTRY_ADDRESS=0x7177a6867296406881E20d6647232314736Dd09A

# Optional Agent Domain Configuration (for AgentCard hosting)
# Domain for RFC 8615 AgentCard hosting (/.well-known/agent-card.json)
# NOTE: v1.0 doesn't store domain on-chain; used only for AgentCard API server
# If you plan to register with tokenURI, it should point to: http://{AGENT_DOMAIN}/.well-known/agent-card.json
# In Docker: Use service name (e.g., "agent-client:8000")
# AGENT_DOMAIN=localhost

# Optional Registration Configuration (v1.0)
# Agent tokenURI for registration (IPFS/HTTPS, optional)
# v1.0 recommendation: Point to AgentCard endpoint for automatic discovery
# Example: AGENT_TOKEN_URI=http://agent-client:8000/.well-known/agent-card.json
# Alternative: Use IPFS for decentralized hosting
# AGENT_TOKEN_URI=ipfs://QmXYZ.../agent-registration.json

# Agent name for AgentCard and registration JSON (defaults to auto-generated if not set)
# AGENT_NAME=My ERC-8004 Agent

# Agent description for AgentCard and registration JSON
# AGENT_DESCRIPTION=A specialized ERC-8004 agent with custom capabilities

# Agent version using semantic versioning (default: 1.0.0)
# AGENT_VERSION=1.0.0

# Optional Registry Addresses (v1.0)
# Reputation Registry for cryptographic feedback system
# REPUTATION_REGISTRY_ADDRESS=0xB5048e3ef1DA4E04deB6f7d0423D06F63869e322

# Validation Registry for independent work verification
# VALIDATION_REGISTRY_ADDRESS=0x662b40A526cb4017d947e71eAF6753BF3eeE66d8

# Optional Configuration
# Logging verbosity (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Gas estimation safety multiplier (default: 1.2)
GAS_MULTIPLIER=1.2

# Transaction confirmation timeout in seconds (default: 120)
TX_TIMEOUT=120

# Optional API Server Configuration
# Port for AgentCard API server (default: 80 for Docker, mapped to 8000 on host)
# API_PORT=80

# Optional Agent Discovery Configuration (v1.0)
# Agent server ID for discovery via tokenURI-based flow
# When set, the client will discover the server agent using v1.0 flow:
#   1. Get tokenURI from IdentityRegistry (points to AgentCard URL)
#   2. Fetch AgentCard from tokenURI
#   3. Parse agent capabilities and skills
# NOTE: v1.0 requires agent ID (not address) as contracts don't support reverse lookups
# Example: AGENT_SERVER_ID=1  (agent ID from IdentityRegistry)
AGENT_SERVER_ID=2
