# Required Configuration
# Ethereum RPC endpoint URL (default: local hardhat node)
RPC_URL=http://localhost:8545

# Private key for transaction signing (without 0x prefix)
# WARNING: Never commit actual private keys to version control
PRIVATE_KEY=your_private_key_here

# Deployed IdentityRegistry contract address
IDENTITY_REGISTRY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Agent domain for registration (RFC 8615 compliant)
# No port needed - API server listens on port 80 inside Docker (standard HTTP)
# Example: agent.example.com or agent.localhost
AGENT_DOMAIN=agent.localhost

# Optional Configuration
# Logging verbosity (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Gas estimation safety multiplier (default: 1.2)
GAS_MULTIPLIER=1.2

# Transaction confirmation timeout in seconds (default: 120)
TX_TIMEOUT=120

# Optional AgentCard Customization
# Custom agent name (defaults to "ERC-8004 Agent {id}" if not set)
# AGENT_NAME=My Custom Agent

# Custom agent description (defaults to standard description if not set)
# AGENT_DESCRIPTION=A specialized ERC-8004 agent with custom capabilities

# Agent version using semantic versioning (default: 1.0.0)
# AGENT_VERSION=1.0.0

# Optional API Server Configuration
# Port for AgentCard API server (default: 80 for Docker, mapped to 8000 on host)
# API_PORT=80

# Optional Agent Discovery Configuration
# Agent server address to discover on startup (use agent-server's Ethereum address)
# Example: AGENT_SERVER_ADDRESS=0xYourAgentServerAddress
# In Docker, the domain will be resolved and fetched from http://agent-server:8001
# AGENT_SERVER_ADDRESS=

# Future: ReputationRegistry contract address
# REPUTATION_REGISTRY_ADDRESS=

# Future: ValidationRegistry contract address
# VALIDATION_REGISTRY_ADDRESS=
